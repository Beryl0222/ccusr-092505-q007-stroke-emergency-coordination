{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "急症预警转运协同领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "CALL_RECEIVED",
        "SYMPTOM_REPORTED",
        "LOCATION_AUTHORIZATION_GRANTED",
        "LOCATION_AUTHORIZATION_REVOKED",
        "TRIAGE_HINT_EMITTED",
        "PROFESSIONAL_DECISION_RECORDED",
        "RISK_LOCKED",
        "ON_SCENE_GUIDANCE_ISSUED",
        "FAMILY_ACKNOWLEDGED",
        "ONSET_TIME_CORRECTED",
        "DUPLICATE_REPORT_MERGED",
        "DUPLICATE_REPORT_REJECTED",
        "ROUTE_PROPOSED",
        "ROUTE_SUSPENDED",
        "ROUTE_RECALCULATED",
        "TRANSPORT_ASSIGNED",
        "AMBULANCE_DEPARTED",
        "AMBULANCE_ARRIVED",
        "AMBULANCE_OFFLINE",
        "AMBULANCE_RECONNECTED",
        "HOSPITAL_CAPACITY_CHANGED",
        "HOSPITAL_ACCEPTED",
        "HANDOFF_RECORDED",
        "CASE_CLOSED",
        "RECEIPT_ACKNOWLEDGED",
        "NOTIFICATION_SENT"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "emergency_call",
        "symptom_observation",
        "transport_task",
        "hospital_capacity"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "description": "合并链路追踪：同一致事件流的所有事件共享"
    },
    "causation_id": {
      "type": "string",
      "description": "触发本事件的上一条事件标识"
    },
    "operator_id": {
      "type": "string",
      "description": "登记/判断/更正的责任人"
    },
    "role_required": {
      "type": "string",
      "description": "敏感字段（位置、病史）读取所需角色，配合投影做最小可见"
    },
    "payload": {
      "type": "object",
      "description": "业务数据统一放在 payload，交换层不展开校验，由应用层规则校验"
    }
  },
  "additionalProperties": true
}
